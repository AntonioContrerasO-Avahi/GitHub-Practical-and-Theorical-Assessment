# Copy this file to .env and fill in your values, then: source .env

# Required — S3 bucket provisioned by Terraform
S3_BUCKET=avahi-rag-pipeline-dev-<your-suffix>
AWS_REGION=us-east-1

# Optional — defaults to "dev" if unset
PIPELINE_ENV=dev

# Optional — paste your Slack Incoming Webhook URL here to enable failure alerts
# Get it from: https://api.slack.com/apps → your app → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../<token>
