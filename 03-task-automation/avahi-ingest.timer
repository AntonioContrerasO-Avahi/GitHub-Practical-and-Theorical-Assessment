# /etc/systemd/system/avahi-ingest.timer
#
# Schedules avahi-ingest.service daily at 2:30 AM.
# Catches up missed runs if the server was down (Persistent=true).

[Unit]
Description=Daily trigger for Avahi RAG Ingestion Pipeline

[Timer]
OnCalendar=*-*-* 02:30:00   # every day at 2:30 AM
Persistent=true              # if server was down at 2:30, fire immediately on next boot
RandomizedDelaySec=60        # jitter up to 60s — avoids thundering herd on multi-server setups

[Install]
WantedBy=timers.target       # activated as part of normal boot targets
